# PostgreSQL connection string (no quotes needed)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Server port
PORT=3000

# Gemini API Key — obtain from https://aistudio.google.com/app/apikey
# IMPORTANT: Must be an API Key (starts with "AIza..."), NOT an OAuth token (starts with "AQ.")
# OAuth tokens (from gcloud auth print-access-token) are short-lived and will cause 401 UNAUTHENTICATED errors.
GEMINI_API_KEY=AIzaSy...

# Optional: restrict CORS to your frontend origin (defaults to http://localhost:3001)
# FRONTEND_ORIGIN=https://your-frontend.com
